[Unit]
Description=Asistente personal AI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/AI
ExecStart=/usr/bin/env node %h/AI/ia.mjs servir
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
TimeoutStopSec=45

[Install]
WantedBy=default.target
